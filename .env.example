ANTHROPIC_API_KEY=tu_api_key_aqui

# Nombre que JARVIS reconoce para activarse por voz
WAKE_WORD=jarvis

# Modelo de Claude a usar. claude-haiku-4-5 es el más económico (recomendado para
# uso diario); claude-sonnet-5 es un punto medio; claude-opus-4-8 es el más caro.
CLAUDE_MODEL=claude-haiku-4-5

# Voz neuronal (edge-tts). Lista completa: edge-tts --list-voices
JARVIS_VOICE=es-AR-TomasNeural
JARVIS_VOICE_RATE=+0%

# Generados automáticamente por: python -m jarvis.voice.calibrate
MIC_DEVICE_INDEX=
ENERGY_THRESHOLD=

# Token secreto para entrar a JARVIS desde el navegador del teléfono (modo web)
JARVIS_WEB_TOKEN=

# IA local gratuita (Ollama) usada como respaldo automático cuando falla la API de
# Claude (sin créditos, sin internet, rate limit, etc.). Requiere tener Ollama
# instalado y corriendo (https://ollama.com) con el modelo descargado, ej.:
#   ollama pull llama3.2:3b
# OLLAMA_MODEL=llama3.2:3b es rápido y liviano; OLLAMA_MODEL=qwen2.5:7b da mejores
# respuestas pero es más lento.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
